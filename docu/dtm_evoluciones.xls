#VALOR1ctrlEVO_numericDEBITO (ml)000False0DEBITO (ml) #VALOR0False001ctrlEVO_textTIPO000False0TIPO #VALOR1ctrlEVO_yesnoOSTOMIAS-10000False0OSTOMIAS #VALOR1ctrlEVO_textLOCALIZACION:000False0LOCALIZACION: #VALOR1ctrlEVO_textDEBITO:000False0DEBITO: #VALOR1ctrlEVO_rtfOBSERVACION GASTROINTESTINAL<p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Abdomen blando, levemente doloroso a la palpacion en forma difusa, con RHA positivos hipoactivos, con catarsis negativa y diuresis positiva. Heridas sin signos de inflamacion o infeccion. Con buena toleancia gastrica a NEC 1500 ml/m2sc/dia.<o:p></o:p></span></p>0000False1ctrlEVO_SubTitleASPECTO GENITOURIANO1ctrlEVO_yesnoACORDE A SEXO Y EDAD-10000False0ACORDE A SEXO Y EDAD #VALOR1ctrlEVO_numericDIURESIS TOTAL000False0DIURESIS TOTAL #VALOR0False001ctrlEVO_numericml / hora000False0ml / hora #VALOR0False001ctrlEVO_numericml / Kg / hora000False0ml / Kg / hora #VALOR0False001ctrlEVO_textDIURETICOS000False0DIURETICOS #VALOR1ctrlEVO_yesnoSONDA VESICAL-10000False0SONDA VESICAL #VALOR1ctrlEVO_yesnoTERAPIA DIALITICA-10000False0TERAPIA DIALITICA #VALOR1ctrlEVO_textTIPO000False0TIPO #VALOR1ctrlEVO_rtfOBSERVACIONES GENITOURIANO0000False1ctrlEVO_SubTitleASPECTO HEMATOLOGICO1ctrlEVO_yesnoTRANSFUSIONES-10000False0TRANSFUSIONES #VALOR1ctrlEVO_textGR000False0GR #VALOR1ctrlEVO_textPLASMA FRESCO000False0PLASMA FRESCO #VALOR1ctrlEVO_textPLAQUETAS000False0PLAQUETAS #VALOR1ctrlEVO_textCRIOPRECIPITADOS000False0CRIOPRECIPITADOS #VALOR1ctrlEVO_rtfOBSERVACIONES HEMATOLOGICAS0000False1ctrlEVO_SubTitleASPECTO MUSCULOESQUELETICO1ctrlEVO_textPOSTURA000False0POSTURA #VALOR1ctrlEVO_textASIMETRIAS000False0ASIMETRIAS #VALOR1ctrlEVO_yesnoMOVILIDAD ARTICULAR CONSERVADA-10000False0MOVILIDAD ARTICULAR CONSERVADA #VALOR1ctrlEVO_yesnoFRACTURAS-10000False0FRACTURAS #VALOR1ctrlEVO_textEXPUESTAS (Gustilo)000False0EXPUESTAS (Gustilo) #VALOR1ctrlEVO_rtfOBSERVACIONES MUSCULOESQUELETICO0000False1ctrlEVO_SubTitleASPECTO INFECTOLOGICO1ctrlEVO_textHemocultivo000False01ctrlEVO_textUrocultivo000False01ctrlEVO_textAspirado Traqueal000False01ctrlEVO_textAspirado virologico000False01ctrlEVO_rtfAntibióticos<p>Afebril, sin signos toxico infeccioso, en tratamiento con meropenem por ITU a E. Coli dia 3 de 7</p>0000False1ctrlEVO_rtfACCESOS VASCULARES0000False1ctrlEVO_textACCESOS VENOSOS PERIFERICOS (UBICACIÓN / PERMANENCIA)000False0ACCESOS VENOSOS PERIFERICOS (UBICACIÓN / PERMANENCIA) #VALOR1ctrlEVO_textACCESOS VENOSOS CENTRAL (UBICACIÓN / PERMANENCIA)000False0ACCESOS VENOSOS CENTRAL (UBICACIÓN / PERMANENCIA) #VALOR1ctrlEVO_textLINEA ARTERIAL (UBICACIÓN / PERMANENCIA)000False0LINEA ARTERIAL (UBICACIÓN / PERMANENCIA) #VALOR1ctrlEVO_rtfEXAMENES COMPLEMENTARIOS0000False1ctrlEVO_rtfTRATAMIENTO<p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">MEropenem&nbsp;</span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Levomepro TN 12.5 mg<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Clobazam 5 y 10 mg<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Fenobarbital 50 c/12 hs<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span lang=""EN-US"" style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-ansi-language:EN-US; mso-fareast-language:ES-AR"">Levetira 750 /500 mg<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span lang=""EN-US"" style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-ansi-language:EN-US; mso-fareast-language:ES-AR"">Fluti+salmet 250/25&nbsp; c/12<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Omeprazol c/24<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Hioscina (0.3) c/12&nbsp;<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Reliveran SIM<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">Ketorolac 10 c/8h<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">polietilnglicol cada 12hs<o:p></o:p></span></p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">1/4 enemol SIM<o:p></o:p></span></p><p> </p><p class=""MsoNormal"" style=""margin-bottom: 7.5pt; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;""><span style=""font-size:10.0pt;font-family:&quot;Open Sans&quot;,sans-serif; mso-fareast-font-family:&quot;Times New Roman&quot;;color:#676A6C;mso-fareast-language: ES-AR"">PHP 50ML/H/140/20<o:p></o:p></span></p>0000False1ctrlEVO_rtfMODIFICACIONES Y CONDUCTAS<p>Continua bajo control clinico evolutivo</p>0000False1";;;;;;;;;;58082;;;;;;1528;1;17/04/2026 14:36:04;1528;1;17/04/2026 14:42:06;;;0;;;0;0
